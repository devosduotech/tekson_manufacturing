        <!-- Operations Detail -->
        <mxCell id="ops_detail" value="&lt;b&gt;OPERATION TYPES &amp; WORKSTATIONS&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;br&gt;Shearing → Shearing Machine (Ralu In / RP)&lt;br&gt;Sr. No. Punching → Sr. No. Punching (RA)&lt;br&gt;Folding → Folding Machine (RA / Ralu In)&lt;br&gt;Fin Forming → Fin Forming and Cutting (Ralu In)&lt;br&gt;Turbu Forming → Turbulator Forming (Ralu In)&lt;br&gt;Bar Cutting → Aluminium Bar Cutting (Ralu In)&lt;br&gt;Tube Sheet Cutting → Cut To Length (Ralu In)&lt;br&gt;Core Assembly → Core Fixing (Ralu Weld)&lt;br&gt;Core Brazing → Brazing Furnace (Ralu Weld)&lt;br&gt;Tank Assembly → Mig Welding (Ralu Weld)&lt;br&gt;Tank To Core → Mig Welding (Ralu Weld)&lt;br&gt;Angle Assembly → Mig Welding (Ralu Weld)&lt;br&gt;Leak Testing → Leak Test (Ralu Weld)&lt;br&gt;Size Cutting → Accurate Cutting (W / Ralu Weld)&lt;br&gt;Drilling &amp; Boring → Drilling, Boring and Milling (CNC)&lt;br&gt;Helicoil Insert → Helicoil &amp; Tapping (Ralu Weld)&lt;br&gt;Painting → RA Painting (RA)&lt;br&gt;Assembly → RA Assembly (RA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
