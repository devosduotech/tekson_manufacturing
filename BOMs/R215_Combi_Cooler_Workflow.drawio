        <mxCell id="flow_title" value="&lt;b&gt;PRODUCTION FLOW SUMMARY&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#f57f17;" vertex="1" parent="1">
          <mxGeometry x="1550" y="1960" width="200" height="25" as="geometry" />
        </mxCell>
        <mxCell id="flow_text" value="1. &lt;b&gt;Stores&lt;/b&gt; transfers raw materials to Department WIP (Stores → WIP-W, WIP-Ralu In, etc.)&lt;br&gt;2. &lt;b&gt;Level 3 BOMs&lt;/b&gt; produce end plates, fins, turbulators, spacer bars in Ralu In / RA / RP / CNC&lt;br&gt;3. &lt;b&gt;⚠ Sr. No. Punching SPLIT&lt;/b&gt;: End plates needing Sr. No. go through Shearing → Sr. No. Punching (RA).&lt;br&gt;   End plates NOT needing Sr. No. skip directly to Core Assembly&lt;br&gt;4. &lt;b&gt;Level 2 BOMs&lt;/b&gt; (Cores, Tanks) assembled in Ralu Weld: Core Assembly → Core Brazing, Tank Assembly&lt;br&gt;5. &lt;b&gt;Level 1 BOMs&lt;/b&gt; (CAC, OC, RAD) assembled in Ralu Weld: Tank To Core → Angle Assembly → Leak Testing&lt;br&gt;6. &lt;b&gt;Level 0 BOM&lt;/b&gt; (R215 Combi Cooler) final assembly in Ralu Weld: Final Assembly → PDI&lt;br&gt;7. &lt;b&gt;Manufacture Stock Entry&lt;/b&gt; created → Finished Goods Stores" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#333;" vertex="1" parent="1">
          <mxGeometry x="60" y="1985" width="3400" height="80" as="geometry" />
        </mxCell>

